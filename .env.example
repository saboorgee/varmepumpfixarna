# Copy to .env (git-ignored) and fill in. Read by the backend container only;
# the storefront receives just MEDUSA_PUBLISHABLE_KEY and STOREFRONT_COOKIE_SECURE.

# --- Database (Supabase PostgreSQL) -------------------------------------------
# Connect as the dedicated `medusa` role created by apps/backend/sql/supabase-setup.sql.
# URL-encode special characters in the password.
#
# Session pooler (IPv4, default) – Dashboard → Connect → "Session pooler":
DATABASE_URL=postgresql://medusa.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (IPv6 unless the IPv4 add-on is enabled):
# DATABASE_URL=postgresql://medusa:<password>@db.<project-ref>.supabase.co:5432/postgres
# The transaction pooler (port 6543) is NOT supported.

# Schema holding all Medusa tables (must match the role's search_path).
DATABASE_SCHEMA=medusa

# TLS: verify-full (default) | verify-ca | no-verify (troubleshooting only) | disable
DATABASE_SSL=verify-full
# Supabase CA certificate (Dashboard → Database → Settings → SSL Configuration),
# saved as ./certs/supabase-ca.crt on the host (mounted read-only).
DATABASE_SSL_CA_FILE=/app/certs/supabase-ca.crt

# Small pool – the session pooler limits connections per role.
DATABASE_POOL_MAX=5

# --- Medusa ----------------------------------------------------------------
# Generate with: openssl rand -hex 32   (or any 32+ random characters)
JWT_SECRET=<generate-a-long-random-value>
COOKIE_SECRET=<generate-a-long-random-value>

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# Browser-reachable backend URL (used in product image URLs).
MEDUSA_PUBLIC_URL=http://localhost:9000

# Admin session cookie: false for local http, true behind HTTPS.
MEDUSA_COOKIE_SECURE=false

# Run `medusa db:migrate` on every backend start (idempotent).
MIGRATE_ON_START=true

# --- Images (server deployments) ---------------------------------------------
# Defaults: ghcr.io/saboorgee/varmepumpfixarna-{backend,storefront}:latest
# Pin a specific build on the server, e.g. :sha-1a2b3c4
# BACKEND_IMAGE=ghcr.io/saboorgee/varmepumpfixarna-backend:latest
# STOREFRONT_IMAGE=ghcr.io/saboorgee/varmepumpfixarna-storefront:latest

# --- Storefront --------------------------------------------------------------
# Printed by: docker compose run --rm backend seed
MEDUSA_PUBLISHABLE_KEY=
# Cart cookie Secure flag: false for local http, true behind HTTPS.
STOREFRONT_COOKIE_SECURE=false
