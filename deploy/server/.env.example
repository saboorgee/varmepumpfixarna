# Copy to .env next to docker-compose.yml on the server, fill in, then:
#   chmod 600 .env
# Never commit or share the filled-in file.

# --- Domains (routed by nginx-proxy; DNS + HTTPS via Cloudflare) -------------
STOREFRONT_DOMAIN=varmepumpfixarna.se
BACKEND_DOMAIN=admin.varmepumpfixarna.se

# --- Database (Supabase, Session pooler, role `medusa`) ----------------------
# Dashboard → Connect → Session pooler. Change the user to medusa.<project-ref>
# and use the medusa role's password (URL-encode special characters).
DATABASE_URL=postgresql://medusa.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=medusa
DATABASE_SSL=verify-full
DATABASE_SSL_CA_FILE=/app/certs/supabase-ca.crt
DATABASE_POOL_MAX=5

# --- Medusa secrets: two different values from `openssl rand -hex 32` -------
JWT_SECRET=
COOKIE_SECRET=

# --- Public URLs (HTTPS through Cloudflare) ----------------------------------
STORE_CORS=https://varmepumpfixarna.se
ADMIN_CORS=https://admin.varmepumpfixarna.se
AUTH_CORS=https://admin.varmepumpfixarna.se
MEDUSA_PUBLIC_URL=https://admin.varmepumpfixarna.se
MEDUSA_COOKIE_SECURE=true

# Apply Medusa database migrations on every backend start (idempotent).
MIGRATE_ON_START=true

# --- Storefront --------------------------------------------------------------
# Printed by: docker compose run --rm backend seed
MEDUSA_PUBLISHABLE_KEY=
STOREFRONT_COOKIE_SECURE=true

# --- Images ------------------------------------------------------------------
# latest = newest build from main. Pin a build with e.g. IMAGE_TAG=sha-b861df1
IMAGE_TAG=latest
